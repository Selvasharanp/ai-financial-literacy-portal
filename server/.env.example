PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Identify this server to the one-time reverse-geocoding service. Include a contact email in production.
NOMINATIM_USER_AGENT=FinancialLiteracyPortal/1.0 (contact: your-email@example.com)
# Comma-separated browser origins allowed to call this API.
CLIENT_URL=http://localhost:5173

# Email Delivery Provider (SMTP) for Collaborative Trip Invitations:
# Set these to enable real-time email delivery for trip invites.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="FinWise Portal" <no-reply@finwise.com>

# AI Travel Budget Planner:
# Uses the existing GROQ_API_KEY and GROQ_MODEL for intelligent travel itinerary generation.
# No additional API key required.
